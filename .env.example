# Twilio Manager — environment credentials
# Copy this file to .env and fill in your values.
# These are used as defaults when no credentials have been saved via the UI.
# Credentials saved through Settings always take priority over this file.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15551234567
